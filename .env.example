# GEMINI_API_KEY: Required if server-side Gemini API features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application (used for callbacks and canonical links).
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Optional Frontend Environment Variables (for Vercel / External Hosting)
# Note: In AI Studio, firebase-applet-config.json provides these automatically.
# Never put private service account keys or M-Pesa secrets in VITE_* variables!
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_APPCHECK_RECAPTCHA_KEY=""
# Public Web Push Certificate (VAPID) key from Firebase Console -> Project Settings -> Cloud Messaging
VITE_FIREBASE_VAPID_KEY=""

# ------------------------------------------------------------------
# Firebase Cloud Functions Server-Side Secrets (Configure via Firebase Secret Manager)
# firebase functions:secrets:set MPESA_CONSUMER_KEY MPESA_CONSUMER_SECRET MPESA_PASSKEY
# ------------------------------------------------------------------
# MPESA_ENV="sandbox"
# MPESA_SHORTCODE=""
# MPESA_CALLBACK_SECRET=""
